{
  "name": "@fukamu/design-tokens",
  "version": "0.1.0",
  "description": "Versioned design-token contract shared by FUKAMU products.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/js/index.cjs",
  "module": "./dist/js/index.mjs",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "./dist/css/tokens.css"
  ],
  "files": [
    "dist",
    "tokens",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/index.mjs",
      "require": "./dist/js/index.cjs"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.json": "./dist/json/tokens.json",
    "./manifest.json": "./dist/manifest.json",
    "./figma-mapping.json": "./dist/figma/mapping.json",
    "./reference": "./dist/reference/tokens.md",
    "./source": "./tokens/fukamu.tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pack": "node scripts/package-smoke.mjs",
    "check": "npm run validate && npm run check:generated && npm run verify:bundle && npm test && npm run test:pack"
  }
}
